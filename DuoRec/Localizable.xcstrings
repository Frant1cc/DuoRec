    "transcription.subtitle" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe locally with Whisper and filter DuoRec recordings by audio source. Choose your model in Language Recognition. Switching pages keeps your text; closing the window clears it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Whisper 在本机转写，按来源筛选 DuoRec 录音；可在「语言识别」页选择模型。切换页面保留文字，关闭窗口后清空。"
          }
        }
      }
    },
