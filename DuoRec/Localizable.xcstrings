    "whisper.storage_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model downloads connect to Hugging Face. Files are kept in DuoRec’s Application Support folder. Import a matching original ggml .bin file if you already have one. Removing a model keeps recordings and transcripts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型从 Hugging Face 下载，保存在 DuoRec 的应用支持目录中。也可选中模型后导入对应的原版 ggml .bin 文件。删除模型不会删除录音或转写文字。"
          }
        }
      }
    },
