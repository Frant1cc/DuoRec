    "whisper.language.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically detect the language of each audio chunk and transcribe in that language without translation. Chinese transcription uses Simplified Chinese. Supports the languages recognized by your model. Short phrases and language switches within a sentence may be less accurate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别每段语音的语言，按原语言转写，不翻译；中文统一使用简体。支持模型可识别的多种语言；短句、同一句内频繁切换语言仍可能识别不准。"
          }
        }
      }
    },
    "whisper.local_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio stays on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音始终留在本机"
          }
        }
