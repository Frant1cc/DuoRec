{
  "sourceLanguage" : "en",
  "strings" : {
    "permissions.needs_authorization" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "System Audio: Authorization Needed" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统声音：待授权" } }
      }
    },
    "permissions.request_help" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen recording access is requested when you click Grant Permissions, Start Recording, or Test Input. Transcribing existing recordings does not require it." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点击“授予权限”“开始录音”或“测试输入”时才会请求屏幕与系统声音权限。转写已有录音无需此权限。" } }
      }
    },
    "transcription.empty.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Click “Import Audio” in the upper-right corner to start transcribing." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点击右上角的「导入音频」开始转写" } }
      }
    },
    "transcription.copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "transcription.copy_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the selected text to the clipboard. Use Select All (⌘A) to copy all visible text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将选中的文字复制到剪贴板。全选（⌘A）后可复制当前显示的全部文字。"
          }
        }
      }
    },
    "transcription.copied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied to Clipboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制到剪贴板"
          }
        }
      }
    },
    "transcription.copy_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t copy. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能复制，请重试。"
          }
        }
      }
    },
    "transcription.import_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an audio or video file to transcribe on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择音频或视频文件，在本机转写成文字。"
          }
        }
      }
    },
    "navigation.recording": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音"
          }
        }
      }
    },
    "navigation.transcription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写"
          }
        }
      }
    },
    "app.settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "recording.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture system audio and your microphone in one recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时记录系统声音和麦克风，保存在一个录音文件中。"
          }
        }
      }
    },
    "updates.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software Updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件更新"
          }
        }
      }
    },
    "transcription.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe a Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将录音转成文字"
          }
        }
      }
    },
    "updates.check": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        }
      }
    },
    "updates.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish recording or input monitoring before updating DuoRec."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束录音或测试输入，再更新 DuoRec。"
          }
        }
      }
    },
    "updates.in_progress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking or installing an update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查或安装更新"
          }
        }
      }
    },
    "updates.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and install updates here. Finish recording or input monitoring first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接下载并安装更新。请先结束录音或测试输入。"
          }
        }
      }
    },
    "error.saved_raw_recording" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The MP4 could not be saved. A playable original recording has been saved; use Show in Finder to open it." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "MP4 保存失败，已保存可播放的原始录音。请点击“在访达中显示”查看。" } }
      }
    },
    "error.recording_retained" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The recording could not be saved. The original file has been kept for recovery. Quit was cancelled if requested; check the recovery folder." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音保存未完成，原始文件已保留供恢复。如果正在退出，已取消本次退出；请查看待恢复文件夹。" } }
      }
    },
    "error.recovery_retained" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Some interrupted recordings could not be recovered automatically. Their original files have been kept in the recovery folder." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "部分中断录音无法自动恢复，原始文件已保留在待恢复文件夹中。" } }
      }
    },
    "recording.reveal_recovery" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Recovery Folder" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开待恢复文件夹" } }
      }
    },
    "action.preparing" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备" } }
      }
    },
    "action.saving" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Saving" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在保存" } }
      }
    },
    "action.start_recording" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Recording" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始录音" } }
      }
    },
    "action.stop_and_save" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop and Save" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止并保存" } }
      }
    },
    "alert.recording_failed.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording Couldn’t Continue" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音未能继续" } }
      }
    },
    "common.off" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Off" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" } }
      }
    },
    "common.ok" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "OK" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "好" } }
      }
    },
    "error.audio_writer.append_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t write the recording data." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音数据写入失败。" } }
      }
    },
    "error.audio_writer.cannot_add_inputs" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t create the system audio and microphone tracks." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法创建系统声音和麦克风音轨。" } }
      }
    },
    "error.audio_writer.export_unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The system couldn’t create an audio export task." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统无法创建音频导出任务。" } }
      }
    },
    "error.audio_writer.finish_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The recording file didn’t finish correctly." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音文件没有正确完成。" } }
      }
    },
    "error.audio_writer.missing_track" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The recording is missing the system audio or microphone track." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音中缺少系统声音或麦克风音轨。" } }
      }
    },
    "error.audio_writer.no_audio" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No audio was received to save." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有收到可保存的声音。" } }
      }
    },
    "error.audio_writer.start_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t start writing the recording file." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法开始写入录音文件。" } }
      }
    },
    "error.folder_bookmark" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected save location will work for now, but DuoRec couldn’t remember the folder. You’ll need to choose it again the next time you open the app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已选择当前保存位置，但无法记住该文件夹。下次打开 App 时需要重新选择。" } }
      }
    },
    "error.no_display" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No display is available for capturing system audio." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "找不到可用于采集系统声音的显示器。" } }
      }
    },
    "error.output_folder" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DuoRec can’t access the Downloads folder." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法访问下载文件夹。" } }
      }
    },
    "error.output_folder_access" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DuoRec can’t write to the selected folder. Choose the save location again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法写入所选文件夹，请重新选择保存位置。" } }
      }
    },
    "error.permission.microphone" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow microphone access before recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先允许麦克风访问。" } }
      }
    },
    "error.permission.screen_monitoring" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Screen & System Audio Recording before testing the input." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先允许“屏幕与系统音频录制”权限。" } }
      }
    },
    "error.permission.screen_recording" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Screen & System Audio Recording. You may need to reopen the app after granting access for the first time." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请允许“屏幕与系统音频录制”权限；首次授权后可能需要重新打开 App。" } }
      }
    },
    "error.retry_after_permission_change" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@\n\nIf you just changed recording permissions, reopen the app and try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@\n\n如果刚刚修改过录音权限，请重新打开 App 后再试。" } }
      }
    },
    "error.system_stopped_recording_detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The system stopped the recording: %@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统停止了录音：%@" } }
      }
    },
    "error.unknown" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unknown error" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未知错误" } }
      }
    },
    "error.write_recording_detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "An error occurred while writing the recording: %@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写入录音时发生错误：%@" } }
      }
    },
    "folder_picker.choose" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择" } }
      }
    },
    "folder_picker.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Future recordings will be saved in this folder." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "之后的录音会保存在这个文件夹中。" } }
      }
    },
    "folder_picker.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose Where to Save Recordings" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择录音保存位置" } }
      }
    },
    "levels.help.idle" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Test the input before recording to make sure both sources have sound." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点击“测试输入”，可在录音前确认双方都有声音" } }
      }
    },
    "levels.help.monitoring" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Testing the input. No audio will be saved." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在测试输入，不会保存任何声音" } }
      }
    },
    "levels.help.recording" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Monitoring and writing the recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在监听并写入录音" } }
      }
    },
    "levels.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Input Levels" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入电平" } }
      }
    },
    "menu.ready_accessibility" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DuoRec is ready" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "DuoRec 已就绪" } }
      }
    },
    "menu.recording_accessibility" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording, %@ elapsed" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在录音，已录制 %@" } }
      }
    },
    "monitor.start" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Test Input" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "测试输入" } }
      }
    },
    "monitor.stop" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Test" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止测试" } }
      }
    },
    "output.default_folder_name" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloads/DuoRec" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载/DuoRec" } }
      }
    },
    "permissions.checking" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking system audio…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查系统声音…" } }
      }
    },
    "permissions.checking_help" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking recording access. Respond to the macOS permission prompt if one appears." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查录音权限；如果 macOS 弹出授权窗口，请完成授权。" } }
      }
    },
    "permissions.check_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check failed" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂时无法检查" } }
      }
    },
    "error.permission.screen_denied" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS denied system audio access for this version. If the permission switch is already on, remove DuoRec from the list, reopen it from Applications, and grant access again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 未允许此版本访问系统声音。若开关已打开，请在权限列表中移除 DuoRec，再从“应用程序”重新打开并授权。" } }
      }
    },
    "permissions.grant" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Grant Access" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "授予权限" } }
      }
    },
    "permissions.help" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Screen & System Audio Recording and microphone access." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要允许屏幕与系统音频录制，以及麦克风访问。" } }
      }
    },
    "permissions.open_settings" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开系统设置" } }
      }
    },
