        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recordings saved in the current folder will appear here." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存到当前文件夹的 DuoRec 录音会显示在这里。" } }
