      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download or import a model in Language Recognition first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在「语言识别」页下载或导入一个模型。"
          }
        }
      }
    },
    "whisper.error.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Model Unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper 模型不可用"
          }
        }
      }
    },
    "whisper.error.model_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download or import the selected Whisper model in Language Recognition, then import your audio again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在「语言识别」页下载或导入选中的 Whisper 模型，再重新导入录音。"
          }
        }
      }
    },
    "whisper.error.invalid_model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file does not match the selected model or is incomplete. Use the original unquantized ggml .bin file and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件与所选模型不符或不完整。请使用对应模型的原版、未量化 ggml .bin 文件后重试。"
          }
        }
      }
    },
    "whisper.error.download_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model download failed. Check your connection to Hugging Face and try again, or import a downloaded model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型下载失败。请检查与 Hugging Face 的连接后重试，也可导入已下载的模型。"
          }
        }
      }
    },
    "whisper.error.load_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper could not load this model. Free some memory or choose a smaller model and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper 无法加载此模型。请释放内存，或选择较小的模型后重试。"
          }
        }
      }
    },
    "whisper.error.recognition_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper could not finish transcription. Try again or choose a smaller model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper 未能完成转写。请重试，或选择较小的模型。"
          }
        }
      }
    },
    "whisper.total_progress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overall transcription progress across all source tracks, weighted by duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部来源音轨的总转写进度，按音轨时长合计"
          }
        }
      }
    },
    "whisper.disk_size": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Disk"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "磁盘大小"}}}},
    "whisper.connecting": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connecting to model server…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在连接模型服务器…"}}}},
    "whisper.pause": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pause"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂停"}}}},
    "whisper.pausing": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pausing…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在暂停…"}}}},
    "whisper.resume": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Resume"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "继续下载"}}}},
    "whisper.resuming": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connecting to resume download…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在连接并继续下载…"}}}},
    "whisper.paused": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Paused · saved"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已暂停 · 已保留"}}}},
    "whisper.discard_partial": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Delete the incomplete download"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "删除未完成的下载"}}}},
    "whisper.reverify": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Verify Again"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新校验"}}}},
    "whisper.error.size_mismatch": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The file is %@; this model requires %@. The downloaded data has been kept. Resume an incomplete download or delete it explicitly to start again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "实际文件大小为 %@，该模型需要 %@。已保留下载数据；未完成时可继续下载，也可主动删除后重下。"}}}},
    "whisper.error.checksum_mismatch": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The file checksum did not match the model. The downloaded file has been kept. Verify it again, or delete it explicitly before downloading again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "文件校验值与模型不符，下载文件已保留。可重新校验，或主动删除后重新下载。"}}}}
  },
  "version" : "1.0"
}
