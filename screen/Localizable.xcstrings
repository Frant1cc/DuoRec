    },
    "common.ok" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "OK" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "好" } }
      }
    },
    "error.audio_writer.append_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t write the recording data." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音数据写入失败。" } }
      }
    },
    "error.audio_writer.cannot_add_inputs" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t create the system audio and microphone tracks." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法创建系统声音和麦克风音轨。" } }
      }
    },
    "error.audio_writer.export_unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The system couldn’t create an M4A export task." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统无法创建 M4A 导出任务。" } }
      }
    },
    "error.audio_writer.finish_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The recording file didn’t finish correctly." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音文件没有正确完成。" } }
      }
    },
    "error.audio_writer.missing_track" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The recording is missing the system audio or microphone track." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音中缺少系统声音或麦克风音轨。" } }
      }
    },
    "error.audio_writer.no_audio" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No audio was received to save." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有收到可保存的声音。" } }
      }
    },
    "error.audio_writer.start_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t start writing the recording file." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法开始写入录音文件。" } }
      }
    },
    "error.folder_bookmark" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected save location will work for now, but DuoRec couldn’t remember the folder. You’ll need to choose it again the next time you open the app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已选择当前保存位置，但无法记住该文件夹。下次打开 App 时需要重新选择。" } }
      }
    },
    "error.no_display" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No display is available for capturing system audio." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "找不到可用于采集系统声音的显示器。" } }
      }
    },
    "error.output_folder" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DuoRec can’t access the Downloads folder." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法访问下载文件夹。" } }
      }
    },
    "error.output_folder_access" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DuoRec can’t write to the selected folder. Choose the save location again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法写入所选文件夹，请重新选择保存位置。" } }
      }
    },
    "error.permission.microphone" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow microphone access before recording." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先允许麦克风访问。" } }
      }
    },
    "error.permission.screen_monitoring" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Screen & System Audio Recording before testing the input." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先允许“屏幕与系统音频录制”权限。" } }
      }
    },
    "error.permission.screen_recording" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Screen & System Audio Recording. You may need to reopen the app after granting access for the first time." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请允许“屏幕与系统音频录制”权限；首次授权后可能需要重新打开 App。" } }
      }
    },
    "error.retry_after_permission_change" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@\n\nIf you just changed recording permissions, reopen the app and try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@\n\n如果刚刚修改过录音权限，请重新打开 App 后再试。" } }
      }
    },
    "error.system_stopped_recording_detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The system stopped the recording: %@" } },
